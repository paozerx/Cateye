APP_NAME=Cateye API
CORS_ORIGINS=["http://localhost:3000"]
# Replace username, password and database with your local PostgreSQL settings.
# Percent-encode special characters in the password, e.g. @ becomes %40.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/cateye
# Set a long random value before deploying (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
